namespace {{ Namespace }};

using MediatR;
using Microsoft.AspNetCore.Mvc;

[Route("api/[controller]")]
[ApiController]
public class {{ Name }}sController : ControllerBase
{
    private readonly IMediator _mediator;

    public {{ Name }}sController(IMediator mediator)
    {
        _mediator = mediator;
    }

    [HttpPost]
    public async Task<ActionResult<int>> Create(Create{{ Name }}Command command)
    {
        var id = await _mediator.Send(command);
        return Ok(id);
    }

    [HttpGet("{id}")]
    public async Task<ActionResult<{{ Name }}Dto>> GetById(int id)
    {
        var result = await _mediator.Send(new Get{{ Name }}ByIdQuery { Id = id });
        if (result == null) return NotFound();
        return Ok(result);
    }
}